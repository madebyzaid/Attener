<Window x:Class="AttendanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AttendanceApp.Views"
        Title="Attendance App" Width="1200" Height="760" MinWidth="900" MinHeight="600"
        Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" Padding="20,24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,0,28">
                    <TextBlock Text="ATTENDANCE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Your semester, clearly tracked" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,10" />
                    <Button Content="Overview" Tag="Overview" Click="Navigate_Click" Style="{StaticResource NavigationButtonStyle}" Foreground="{StaticResource PrimaryTextBrush}" />
                    <Button Content="Timetable" Tag="Timetable" Click="Navigate_Click" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Attendance" Tag="Attendance" Click="Navigate_Click" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Calendar" Tag="Calendar" Click="Navigate_Click" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Subjects" Tag="Subjects" Click="Navigate_Click" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Statistics" Tag="Statistics" Click="Navigate_Click" Style="{StaticResource NavigationButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="40,34">
            <views:OverviewView x:Name="OverviewPage" />
            <views:AttendanceView x:Name="AttendancePage" Visibility="Collapsed" />
            <views:SubjectsView x:Name="SubjectsPage" Visibility="Collapsed" />
            <views:TimetableView x:Name="TimetablePage" Visibility="Collapsed" />
            <views:CalendarView x:Name="CalendarPage" Visibility="Collapsed" />
            <views:StatisticsView x:Name="StatisticsPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="AttendanceApp.Views.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="SessionTemplate">
            <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="10"
                    Padding="16,13" Margin="0,0,0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DayName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Session.SubjectName}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EffectiveDescription}" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TimeRange}" FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Remove from date" Tag="{Binding}"
                            Click="RemoveSession_Click" Padding="12,6"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Background="#292E39" BorderThickness="0" Cursor="Hand" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Timetable" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Set a regular weekly class time. Changes take effect on the date you choose."
                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}"
                CornerRadius="12" Padding="18" Margin="0,22,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subject" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,7" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Day" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,7" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Starts" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,7" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Ends" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,7" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Effective from" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,7" />

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <ComboBox x:Name="SubjectCombo" Height="42" IsEditable="False"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              ToolTip="Choose an active subject. Add subjects on the Subjects page." />
                    <TextBlock x:Name="SubjectEmptyHint" Text="No subjects yet — add one on Subjects"
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="12,0,34,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <ComboBox x:Name="DayCombo" Grid.Row="1" Grid.Column="1" Height="42"
                          Margin="0,0,10,0" />
                <TextBox x:Name="StartTimeBox" Grid.Row="1" Grid.Column="2" Height="42"
                         Text="09:00" Padding="9" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="EndTimeBox" Grid.Row="1" Grid.Column="3" Height="42"
                         Text="10:00" Padding="9" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                <DatePicker x:Name="EffectiveDatePicker" Grid.Row="1" Grid.Column="4" Height="42"
                            SelectedDateChanged="EffectiveDatePicker_SelectedDateChanged" Margin="0,0,10,0" />
                <Button Grid.Row="1" Grid.Column="5" Content="Save session" Padding="15,0"
                        Background="{StaticResource AccentBrush}" Foreground="#111318"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="SaveSession_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="ScheduleHeading" Grid.Row="2" Text="Weekly sessions" FontSize="17"
                   FontWeight="SemiBold" Margin="0,23,0,12" />

        <Grid Grid.Row="3">
            <ItemsControl x:Name="SessionsList" ItemTemplate="{StaticResource SessionTemplate}" />
            <TextBlock x:Name="EmptyStateText" Text="No sessions are scheduled for this date yet."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>

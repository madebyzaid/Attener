<UserControl x:Class="AttendanceApp.Views.TimetableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Timetable" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Click an hour to assign a subject. Adjacent hours for the same subject become one continuous class." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,10" VerticalAlignment="Center"><TextBlock Text="Changes effective from" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker x:Name="EffectiveDatePicker" Width="190" Height="38" SelectedDateChanged="EffectiveDatePicker_SelectedDateChanged"/><TextBlock Text="· 8:00–20:00" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="TimetableGrid" MinWidth="1080"/></ScrollViewer>
  </Grid>
</UserControl>

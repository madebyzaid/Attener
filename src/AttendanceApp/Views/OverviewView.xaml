<UserControl x:Class="AttendanceApp.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Overview" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Your attendance workspace" FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}"
                CornerRadius="14" Padding="26" Margin="0,28,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Semester setup" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Choose the semester start date. The app will create Not Marked records for scheduled classes from that date through today."
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                           TextWrapping="Wrap" MaxWidth="700" Margin="0,9,0,20" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker x:Name="SemesterStartPicker" Width="190" Height="40" />
                    <Button Content="Save date and generate records" Margin="14,0,0,0" Padding="18,0"
                            Height="40" Background="{StaticResource AccentBrush}" Foreground="#111318"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            Click="GenerateRecords_Click" />
                </StackPanel>
                <TextBlock x:Name="GenerationMessage" Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

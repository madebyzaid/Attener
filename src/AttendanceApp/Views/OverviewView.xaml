<UserControl x:Class="AttendanceApp.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Overview" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Semester setup and attendance progress at a glance." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,18"/>
    <UniformGrid Columns="2" Margin="0,0,0,18">
      <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,8,0"><StackPanel><TextBlock Text="Active subjects" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="SubjectCountText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="20" Margin="8,0,0,0"><StackPanel><TextBlock Text="Attendance" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="AttendanceSummaryText" Text="Set semester start date" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    </UniformGrid>
    <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="14" Padding="24">
      <StackPanel><TextBlock Text="Semester setup" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose the first day of your semester. The app creates pending records for scheduled classes from that date through today." Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="800" Margin="0,9,0,18"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><DatePicker x:Name="SemesterStartPicker" Width="190" Height="40"/><Button Content="Save date and generate records" Margin="14,0,0,0" Padding="18,0" Height="40" Background="{StaticResource AccentBrush}" Foreground="#111318" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="GenerateRecords_Click"/></StackPanel>
      <TextBlock x:Name="GenerationMessage" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>
  </StackPanel></ScrollViewer>
</UserControl>

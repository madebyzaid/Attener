<UserControl x:Class="Attener.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Status colours. Each button reads its colour from its Tag. -->
        <SolidColorBrush x:Key="PresentBrush" Color="#5BD68A" />
        <SolidColorBrush x:Key="AbsentBrush" Color="#de546b" />
        <SolidColorBrush x:Key="CancelledBrush" Color="#a25af0" />

        <!-- Present / Absent / Cancelled button: coloured outline when off, filled with its colour when on.
             It sets the TextBlock foreground explicitly because the global TextBlock style would force it to white. -->
        <Style x:Key="StatusToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2B303B" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="Foreground" Value="#111318" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AttendanceTemplate">
            <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="10"
                    Padding="18" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Entry.SubjectName}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScheduledTime}" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Content="Present" Style="{StaticResource StatusToggleStyle}"
                                      Tag="{StaticResource PresentBrush}"
                                      IsChecked="{Binding IsPresent, Mode=OneWay}"
                                      IsEnabled="{Binding CanEdit}" Click="Present_Click" />
                        <ToggleButton Content="Absent" Style="{StaticResource StatusToggleStyle}"
                                      Tag="{StaticResource AbsentBrush}"
                                      IsChecked="{Binding IsAbsent, Mode=OneWay}"
                                      IsEnabled="{Binding CanEdit}" Click="Absent_Click" />
                        <ToggleButton Content="Cancelled" Style="{StaticResource StatusToggleStyle}"
                                      Tag="{StaticResource CancelledBrush}"
                                      IsChecked="{Binding IsCancelled, Mode=OneWay}"
                                      IsEnabled="{Binding CanEdit}" Click="Cancelled_Click" />
                        <Button Content="Delete" Click="DeleteManual_Click"
                                Visibility="{Binding DeleteVisibility}"
                                Margin="14,0,0,0" Padding="14,0" Height="38"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Background="#292E39" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Attendance" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Mark each scheduled class once for the selected date, or add an entry by hand."
                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,0">
            <Button x:Name="ByDateButton" Content="By date" Click="ShowByDate_Click"
                    Padding="13,7" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
            <Button x:Name="PendingButton" Content="Pending" Click="ShowPending_Click"
                    Padding="13,7" BorderThickness="0" Cursor="Hand" />
            <Button Content="+ Add entry" Click="AddManual_Click" Margin="16,0,0,0"
                    Padding="14,7" Background="{StaticResource AccentBrush}" Foreground="#111318"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    ToolTip="Record attendance by hand for any date" />
        </StackPanel>

        <Border x:Name="DateControls" Grid.Row="2" Background="{StaticResource SurfaceBackgroundBrush}"
                CornerRadius="12" Padding="16" Margin="0,12,0,0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Date" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <DatePicker x:Name="AttendanceDatePicker" Width="190" Height="40"
                            SelectedDateChanged="AttendanceDatePicker_SelectedDateChanged" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="PendingHeader" Grid.Row="2" Orientation="Horizontal"
                    Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="Unmarked classes up to today" FontSize="15" FontWeight="SemiBold" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AttendanceList" ItemTemplate="{StaticResource AttendanceTemplate}" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyStateText" Text="Choose a semester start date in Settings to generate attendance records."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="Attener.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- One class row inside a day card. -->
        <DataTemplate x:Key="AttendanceTemplate">
            <Border Background="#191C23" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Entry.SubjectName}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScheduledTime}" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Content="Present" Style="{StaticResource StatusToggleStyle}"
                                      Tag="{StaticResource PresentBrush}"
                                      IsChecked="{Binding IsPresent, Mode=OneWay}" Click="Present_Click" />
                        <ToggleButton Content="Absent" Style="{StaticResource StatusToggleStyle}"
                                      Tag="{StaticResource AbsentBrush}"
                                      IsChecked="{Binding IsAbsent, Mode=OneWay}" Click="Absent_Click" />
                        <ToggleButton Content="Cancelled" Style="{StaticResource StatusToggleStyle}"
                                      Tag="{StaticResource CancelledBrush}"
                                      IsChecked="{Binding IsCancelled, Mode=OneWay}" Click="Cancelled_Click" />
                        <Button Content="Delete" Click="DeleteManual_Click"
                                Visibility="{Binding DeleteVisibility}"
                                Margin="14,0,0,0" Padding="14,0" Height="38"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Background="#292E39" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One card per date. Today's card keeps the TODAY badge and slightly emphasized title,
             but no accent border so it matches the other day cards. -->
        <DataTemplate x:Key="DayCardTemplate">
            <Border CornerRadius="14" Padding="20,18,20,10" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="#2B303B" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="{Binding TitleFontSize}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,3"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="TODAY" FontSize="11" FontWeight="Bold" Foreground="#111318" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource AttendanceTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Attendance" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Mark today's classes, then catch up on earlier ones that are still unmarked."
                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,0">
            <Button Content="+ Add entry" Click="AddManual_Click"
                    Padding="14,7" Background="{StaticResource AccentBrush}" Foreground="#111318"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    ToolTip="Record attendance by hand for any date" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="CardsList" ItemTemplate="{StaticResource DayCardTemplate}" />
                    <TextBlock x:Name="NothingElseText" Text="No earlier classes are waiting."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,6,0,20" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="EmptyStateText" Text="Choose a semester start date in Settings to generate attendance records."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="Attener.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Preferences for your semester. More options will appear here over time."
                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,7,0,22" />

            <!-- One rounded card per topic. Add future settings as more cards below. -->
            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="#2B303B"
                    BorderThickness="1" CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Semester" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Choose the first day of your semester. The app creates pending records for scheduled classes from that date through today."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                               TextWrapping="Wrap" MaxWidth="800" HorizontalAlignment="Left"
                               Margin="0,9,0,18" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <DatePicker x:Name="SemesterStartPicker" Width="190" Height="40" />
                        <Button Content="Save and generate records" Margin="14,0,0,0" Padding="18,0" Height="40"
                                Background="{StaticResource AccentBrush}" Foreground="#111318"
                                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                Click="GenerateRecords_Click" />
                    </StackPanel>
                    <TextBlock x:Name="GenerationMessage" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Danger zone -->
            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="#66D64550"
                    BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Danger zone" FontSize="20" FontWeight="SemiBold" Foreground="#F26D78" />
                    <TextBlock Text="Permanently delete all subjects, timetable entries, attendance records and settings. This cannot be undone. To keep a backup first, copy attendance.db from %LOCALAPPDATA%\Attener."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                               TextWrapping="Wrap" MaxWidth="800" HorizontalAlignment="Left"
                               Margin="0,9,0,18" />
                    <Button Content="Delete all data" Padding="18,0" Height="40" HorizontalAlignment="Left"
                            Background="#D64550" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" Click="DeleteAllData_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
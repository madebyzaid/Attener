<UserControl x:Class="Attener.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Preferences for your semester. More options will appear here over time."
                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,5,0,18" />

            <!-- One rounded card per topic. Add future settings as more cards below. -->
            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="18">
                <StackPanel>
                    <TextBlock Text="Semester" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Choose the first day of your semester. The app creates pending records for scheduled classes from that date through today."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="800" HorizontalAlignment="Left"
                               Margin="0,9,0,18" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <DatePicker x:Name="SemesterStartPicker" Width="190" Height="40" />
                        <Button Content="Save and generate records" Margin="14,0,0,0" Padding="18,0" Height="40"
                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                Click="GenerateRecords_Click" />
                    </StackPanel>
                    <TextBlock x:Name="GenerationMessage" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Attendance target" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="The minimum attendance your college requires. Statistics uses it to show how many hours you can still miss, or need to attend."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="800" HorizontalAlignment="Left"
                               Margin="0,9,0,18" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="TargetBox" Width="90" Height="40" Padding="12,9" FontSize="14"
                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                 KeyDown="TargetBox_KeyDown" />
                        <TextBlock Text="%" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Content="Save target" Margin="14,0,0,0" Padding="18,0" Height="40"
                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                Click="SaveTarget_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TargetMessage" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Temporary test data" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Seed a realistic mock semester, including class timetable, attendance and a few manual records. This clears the current database first."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="800" HorizontalAlignment="Left"
                               Margin="0,9,0,18" />
                    <Button Content="Seed test data" Padding="18,0" Height="40" HorizontalAlignment="Left"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" Click="SeedTestData_Click" />
                </StackPanel>
            </Border>

            <!-- Danger zone -->
            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="#663F2630"
                    BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Danger zone" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="Permanently delete all subjects, timetable entries, attendance records and settings. This cannot be undone. To keep a backup first, copy attendance.db from %LOCALAPPDATA%\Attener."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="800" HorizontalAlignment="Left"
                               Margin="0,9,0,18" />
                    <Button Content="Delete all data" Padding="18,0" Height="40" HorizontalAlignment="Left"
                            Background="{StaticResource DangerBrush}" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand" Click="DeleteAllData_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
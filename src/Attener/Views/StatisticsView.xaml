<UserControl x:Class="Attener.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="SubjectStatTemplate">
            <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="10"
                    Padding="16" Margin="0,0,0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="85" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SubjectName}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HoursSummary}" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Value="{Binding PercentageValue}" Maximum="100"
                                 Height="8" VerticalAlignment="Center" Margin="18,0" />
                    <TextBlock Grid.Column="2" Text="{Binding PercentageText}" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Statistics" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="DateRangeText" Text="Attendance summary" FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}"
                CornerRadius="14" Padding="22" Margin="0,22,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Overall attendance" FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="OverallPercentage" Text="—" FontSize="34"
                               FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <ProgressBar x:Name="OverallProgress" Grid.Column="1" Maximum="100"
                             Height="10" VerticalAlignment="Center" Margin="28,0" />
                <TextBlock x:Name="OverallHours" Grid.Column="2" Text="No counted hours yet"
                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <TextBlock x:Name="SubjectsHeading" Grid.Row="2" Text="By subject" FontSize="17"
                   FontWeight="SemiBold" Margin="0,23,0,12" />

        <Grid Grid.Row="3">
            <ItemsControl x:Name="SubjectStatsList" ItemTemplate="{StaticResource SubjectStatTemplate}" />
            <TextBlock x:Name="EmptyStateText" Text="Choose a semester start date on Overview to view statistics."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>


<UserControl x:Class="Attener.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Attener.Views"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Same colours as the Attendance page buttons. -->
        <SolidColorBrush x:Key="PresentDayBrush" Color="#5BD68A" />
        <SolidColorBrush x:Key="AbsentDayBrush" Color="#de546b" />
        <SolidColorBrush x:Key="CancelledDayBrush" Color="#a25af0" />

        <!-- Turns a day's date + the calendar's Tag (date -> status) into a status word. -->
        <local:DayStatusConverter x:Key="DayStatusConverter" />

        <!-- Day cell for this page's calendar. Same look as the global dark day cell, plus:
             each day's Tag holds its attendance status ("Present", "Absent", "Cancelled", "Not Marked"
             or empty), and the triggers below colour the cell from that. Days from the previous or next
             month are never coloured. -->
        <Style x:Key="StatusDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource DayStatusConverter}">
                        <Binding />
                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=Calendar}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="DayBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Margin="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- When two triggers set the same thing, the one lower down wins. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#343B49" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#6B7180" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Not Marked" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#6B7180" />
                            </MultiTrigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#6B7180" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#111318" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Present" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource PresentDayBrush}" />
                                <Setter Property="Foreground" Value="#111318" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Absent" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource AbsentDayBrush}" />
                                <Setter Property="Foreground" Value="#111318" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Cancelled" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource CancelledDayBrush}" />
                                <Setter Property="Foreground" Value="#111318" />
                            </MultiTrigger>
                            <!-- The selected day gets a white ring, so it stays visible on a coloured cell. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CalendarSessionTemplate">
            <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="10"
                    Padding="18,15" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SubjectName}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TimeRange}" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="12,0,0,0" />
                    <Border Grid.Column="2" Background="#292E39" CornerRadius="8"
                            Padding="9,6" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}" TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Calendar" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Choose a date to see each class, its scheduled time, and its attendance status."
                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                        <Calendar x:Name="MonthCalendar" DisplayMode="Month"
                                  CalendarDayButtonStyle="{StaticResource StatusDayButtonStyle}"
                                  SelectedDatesChanged="MonthCalendar_SelectedDatesChanged"
                                  Background="{StaticResource SurfaceBackgroundBrush}"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  BorderThickness="0" />
                    </Viewbox>

                    <!-- Colour key. Only shown while one subject is selected. -->
                    <StackPanel x:Name="LegendPanel" Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed">
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource PresentDayBrush}" />
                        <TextBlock Text="Present" FontSize="12" Margin="6,0,18,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource AbsentDayBrush}" />
                        <TextBlock Text="Absent" FontSize="12" Margin="6,0,18,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource CancelledDayBrush}" />
                        <TextBlock Text="Cancelled" FontSize="12" Margin="6,0,18,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                BorderBrush="#6B7180" BorderThickness="1.5" />
                        <TextBlock Text="Not marked" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="SelectedDateHeading" Text="Classes" FontSize="20" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Scheduled times and attendance status" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                </StackPanel>

                <ComboBox x:Name="SubjectFilter" Grid.Row="1" Height="38" Margin="0,14,0,0"
                          DisplayMemberPath="Label" SelectedValuePath="SubjectId"
                          SelectionChanged="SubjectFilter_SelectionChanged" />

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SessionsList" ItemTemplate="{StaticResource CalendarSessionTemplate}" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyStateText" Text="No classes are scheduled on this date."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="Attener.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Attener.Views"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Turns a day's date + the calendar's Tag (date -> status) into a status word. -->
        <local:DayStatusConverter x:Key="DayStatusConverter" />

        <!-- Day cell for this page's calendar. Same look as the global dark day cell, plus:
             each day's Tag holds its attendance status ("Present", "Absent", "Cancelled", "Not Marked"
             or empty), and the triggers below colour the cell from that. Days from the previous or next
             month are never coloured. -->
        <Style x:Key="StatusDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource DayStatusConverter}">
                        <Binding />
                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=Calendar}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="DayBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Margin="1">
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="{StaticResource HoverBrush}"
                                        Opacity="0.35" CornerRadius="4" Visibility="Collapsed"
                                        IsHitTestVisible="False" />
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- When two triggers set the same thing, the one lower down wins. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Not Marked" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource NotMarkedDayBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Present" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource PresentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PresentTextBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Absent" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource AbsentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsInactive" Value="False" />
                                    <Condition Property="Tag" Value="Cancelled" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource CancelledBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="Transparent" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CalendarSessionTemplate">
            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SubjectName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Background="{StaticResource HoverBrush}" CornerRadius="5"
                                    Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Entry.Type}" FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Entry.Professor}" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,0"
                                   Style="{StaticResource HideIfEmptyTextStyle}" />
                        <TextBlock Text="{Binding Entry.Venue}" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"
                                   Style="{StaticResource HideIfEmptyTextStyle}" />
                        <TextBlock Text="{Binding TimeRange}" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Added manually" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"
                                   Visibility="{Binding ManualVisibility}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Present" Style="{StaticResource StatusButtonStyle}"
                                Tag="{StaticResource PresentBrush}"
                                IsEnabled="{Binding CanEdit}" Click="Present_Click" />
                        <Button Content="Absent" Style="{StaticResource StatusButtonStyle}"
                                Tag="{StaticResource AbsentBrush}"
                                IsEnabled="{Binding CanEdit}" Click="Absent_Click" />
                        <Button Content="Cancelled" Style="{StaticResource StatusButtonStyle}"
                                Tag="{StaticResource CancelledBrush}"
                                IsEnabled="{Binding CanEdit}" Click="Cancelled_Click" />
                        <Button Content="Delete" Click="DeleteManual_Click" Visibility="{Binding DeleteVisibility}"
                                Margin="10,0,0,0" Padding="12,0" Height="38" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SubjectTypeFilterBadgeStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubjectFilterItemStyle" TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="0,1">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Tag="{Binding}"
                                           MouseLeftButtonUp="SubjectNameFilter_MouseLeftButtonUp"
                                           Cursor="Hand" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding TypeBadges}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Letter}" Tag="{Binding}"
                                                    Click="SubjectTypeBadge_Click" ToolTip="{Binding Type}"
                                                    Width="24" Height="24" Padding="0" Margin="5,0,0,0"
                                                    FontSize="13" FontWeight="SemiBold"
                                                    Style="{StaticResource SubjectTypeFilterBadgeStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Calendar" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Choose a date to see each class, its scheduled time, and its attendance status."
                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320" />
                <ColumnDefinition Width="3*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="12"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                        <Calendar x:Name="MonthCalendar" DisplayMode="Month"
                                  CalendarDayButtonStyle="{StaticResource StatusDayButtonStyle}"
                                  SelectedDatesChanged="MonthCalendar_SelectedDatesChanged"
                                  Background="{StaticResource SurfaceBackgroundBrush}"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  BorderThickness="0" />
                    </Viewbox>

                    <!-- Colour key. Only shown while one subject is selected. -->
                    <StackPanel x:Name="LegendPanel" Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed">
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource PresentBrush}" />
                        <TextBlock Text="Present" FontSize="12" Margin="6,0,18,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource AbsentBrush}" />
                        <TextBlock Text="Absent" FontSize="12" Margin="6,0,18,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource CancelledBrush}" />
                        <TextBlock Text="Cancelled" FontSize="12" Margin="6,0,18,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                Background="{StaticResource NotMarkedDayBrush}" />
                        <TextBlock Text="Not marked" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="SelectedDateHeading" Text="Classes" FontSize="20" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Scheduled times and attendance status" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Add entry" Click="AddManual_Click" Margin="10,0,0,0"
                            Padding="12,7" Background="{StaticResource AccentBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                </Grid>

                <ComboBox x:Name="SubjectFilter" Grid.Row="1" Height="38" Margin="0,14,0,0"
                          Style="{StaticResource SubjectTypeFilterComboBoxStyle}" SelectedValuePath="SubjectId"
                          Padding="12,0"
                          ItemContainerStyle="{StaticResource SubjectFilterItemStyle}"
                          SelectionChanged="SubjectFilter_SelectionChanged" />

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SessionsList" ItemTemplate="{StaticResource CalendarSessionTemplate}" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyStateText" Text="No classes are scheduled on this date."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

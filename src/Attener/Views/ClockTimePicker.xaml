<UserControl x:Class="Attener.Views.ClockTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <!-- The visible field: a time you can type, plus a clock button that opens the dial. -->
        <Border x:Name="FieldBorder" Background="{StaticResource SurfaceBackgroundBrush}"
                BorderThickness="1" CornerRadius="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#454B58" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TimeBox" BorderThickness="0" Background="Transparent" Padding="10,0"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         ToolTip="Type a time such as 8 or 08:00, or use the clock"
                         KeyDown="TimeBox_KeyDown" />
                <Button Grid.Column="1" Width="34" Margin="3" BorderThickness="0" Background="Transparent"
                        Foreground="{StaticResource SecondaryTextBrush}" Cursor="Hand" Focusable="False"
                        ToolTip="Pick on a clock" Click="OpenButton_Click">
                    <TextBlock Text="&#xE121;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <!-- The dial. Its contents are drawn in code (ClockTimePicker.xaml.cs). -->
        <Popup x:Name="DialPopup" PlacementTarget="{Binding ElementName=FieldBorder}" Placement="Bottom"
               VerticalOffset="4" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="#454B58"
                    BorderThickness="1" CornerRadius="16" Padding="18">
                <StackPanel Width="260">
                    <TextBlock Text="Select time" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
                        <Border x:Name="HourChip" Width="84" Height="60" CornerRadius="10" Cursor="Hand"
                                MouseLeftButtonDown="HourChip_MouseDown">
                            <TextBlock x:Name="HourChipText" Text="08" FontSize="34"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text=":" FontSize="34" Margin="8,0" VerticalAlignment="Center" />
                        <Border x:Name="MinuteChip" Width="84" Height="60" CornerRadius="10" Cursor="Hand"
                                MouseLeftButtonDown="MinuteChip_MouseDown">
                            <TextBlock x:Name="MinuteChipText" Text="00" FontSize="34"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Canvas x:Name="Dial" Width="260" Height="260" Background="Transparent"
                            MouseLeftButtonDown="Dial_MouseDown" MouseMove="Dial_MouseMove"
                            MouseLeftButtonUp="Dial_MouseUp" MouseLeave="Dial_MouseLeave" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Padding="14,7" Margin="0,0,8,0" BorderThickness="0"
                                Background="#292E39" Foreground="{StaticResource SecondaryTextBrush}"
                                Cursor="Hand" Click="Cancel_Click" />
                        <Button Content="OK" Padding="20,7" BorderThickness="0" FontWeight="SemiBold"
                                Background="{StaticResource AccentBrush}" Foreground="#111318"
                                Cursor="Hand" Click="Ok_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>